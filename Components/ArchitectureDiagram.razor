    var relevantMaterials = await _unitOfWork.CourseMaterial
        .GetAllAsync(m => m.Tags.Contains(prompt) || m.Title.Contains(prompt));

    var contextBuilder = new StringBuilder();
    foreach (var material in relevantMaterials.Take(3))
