@inject IJSRuntime JS

@if (Project is not null)
{
    <div class="arch-deepdive-card">
        <div class="arch-tab-header">
            <div class="arch-tabs">
                <button type="button"
                        class="arch-tab-btn @(activeTab == "diagram" ? "active" : "")"
                        @onclick='() => activeTab = "diagram"'>
                    <span>✦</span> Architecture Diagram
                </button>
                @if (HasDatabaseSchema)
                {
                    <button type="button"
                            class="arch-tab-btn @(activeTab == "database" ? "active" : "")"
                            @onclick='() => activeTab = "database"'>
                        <span>⌁</span> Database Schema (ERD)
                    </button>
                }
                @if (HasCodeSnippet)
                {
                    <button type="button"
                            class="arch-tab-btn @(activeTab == "code" ? "active" : "")"
                            @onclick='() => activeTab = "code"'>
                        <span>{ }</span> @CodeTabLabel
                    </button>
                }
            </div>
            <span class="arch-tag">SYSTEM BLUEPRINT</span>
        </div>

        <div class="arch-tab-body">
            @if (activeTab == "diagram")
            {
                <div class="diagram-canvas">
                    <div class="diagram-layers">
                        @* ═══════════ RAWAFID ═══════════ *@
                        @if (IsSlug("rawafid"))
                        {
                            <div class="diag-layer layer-presentation">
                                <span class="layer-pill">1. PRESENTATION TIER</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>PHP Views & Templates</strong>
                                        <span>Server-rendered pages, includes, layout partials</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Client UI Layer</strong>
                                        <span>HTML5, CSS3, JavaScript, responsive design</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ Form POST / GET Requests ↓</div>

                            <div class="diag-layer layer-services">
                                <span class="layer-pill">2. APPLICATION & BUSINESS LOGIC</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Content & Event Engine</strong>
                                        <span>Article publishing, user permissions</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Multilingual Router</strong>
                                        <span>Localization, category filters</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Admin Panel</strong>
                                        <span>Content CRUD, user management</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ PDO / MySQLi Queries ↓</div>

                            <div class="diag-layer layer-data">
                                <span class="layer-pill">3. DATA ACCESS & PERSISTENCE</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>PHP Data Layer</strong>
                                        <span>PDO connections, prepared statements</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>MySQL Database</strong>
                                        <span>Articles, users, events, categories</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════ TECH XPRESS ═══════════ *@
                        else if (IsSlug("tech-xpress"))
                        {
                            <div class="diag-layer layer-presentation">
                                <span class="layer-pill">1. PRESENTATION TIER</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>ASP.NET Core MVC / Razor</strong>
                                        <span>Controllers, ViewModels, TagHelpers</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Client UI Layer</strong>
                                        <span>HTML5, CSS3, JavaScript, Bootstrap</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ HTTP Requests / Model Binding ↓</div>

                            <div class="diag-layer layer-services">
                                <span class="layer-pill">2. APPLICATION & BUSINESS LOGIC</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Cart & Order Manager</strong>
                                        <span>Order placement, status workflow</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Stripe Payment Service</strong>
                                        <span>Checkout sessions, payment confirmation</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Product Catalog</strong>
                                        <span>Browse, search, categories, admin CRUD</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ Repository & Unit of Work Abstraction ↓</div>

                            <div class="diag-layer layer-data">
                                <span class="layer-pill">3. DATA ACCESS & PERSISTENCE</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Entity Framework Core</strong>
                                        <span>DbContext, Fluent API mappings, LINQ</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Microsoft SQL Server</strong>
                                        <span>Normalized relational tables & indexes</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>ASP.NET Identity</strong>
                                        <span>User store, password hashing, roles</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════ E-LEARNING ═══════════ *@
                        else if (IsSlug("elearning"))
                        {
                            <div class="diag-layer layer-presentation">
                                <span class="layer-pill">1. PRESENTATION TIER</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>ASP.NET Core MVC / Razor</strong>
                                        <span>Controllers, ViewModels, TagHelpers</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>AI Chat Interface</strong>
                                        <span>Conversational UI, real-time responses</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ HTTP Requests / AI Query Pipeline ↓</div>

                            <div class="diag-layer layer-services">
                                <span class="layer-pill">2. APPLICATION & BUSINESS LOGIC</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Course Service</strong>
                                        <span>Tracks, materials, book library</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Conversational AI Engine</strong>
                                        <span>Chatbot queries, study guidance</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Learning Path Manager</strong>
                                        <span>Progress tracking, recommendations</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ Repository & Unit of Work Abstraction ↓</div>

                            <div class="diag-layer layer-data">
                                <span class="layer-pill">3. DATA ACCESS & PERSISTENCE</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Entity Framework Core</strong>
                                        <span>DbContext, Fluent API mappings, LINQ</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Microsoft SQL Server</strong>
                                        <span>Normalized relational tables & indexes</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>ASP.NET Identity</strong>
                                        <span>User store, password hashing, roles</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════ EL WAKEEL LAW FIRM ═══════════ *@
                        else if (IsSlug("el-wakeel"))
                        {
                            <div class="diag-layer layer-presentation">
                                <span class="layer-pill">1. CLIENT-SIDE PRESENTATION</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>HTML5 & Bootstrap 5</strong>
                                        <span>Semantic markup, responsive grid, gold-accented theme</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>CSS3 & JavaScript</strong>
                                        <span>Custom animations, jQuery carousels, smooth scroll</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ Client-Side Interactions & API Calls ↓</div>

                            <div class="diag-layer layer-services">
                                <span class="layer-pill">2. INTEGRATION & LEAD CAPTURE</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Formspree Form Handler</strong>
                                        <span>Contact form submission, email delivery</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>WhatsApp Business API</strong>
                                        <span>Direct consultation booking, click-to-chat</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>SEO & Analytics</strong>
                                        <span>Meta tags, Open Graph, performance optimization</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ Static Hosting & CDN Delivery ↓</div>

                            <div class="diag-layer layer-data">
                                <span class="layer-pill">3. HOSTING & DEPLOYMENT</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Web Hosting Provider</strong>
                                        <span>Static file serving, SSL/TLS, custom domain</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>CDN Assets</strong>
                                        <span>Bootstrap CDN, Font Awesome, Google Fonts</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════ DEVERP ═══════════ *@
                        else if (IsSlug("deverp"))
                        {
                            <div class="diag-layer layer-presentation">
                                <span class="layer-pill">1. CLIENT-SIDE PRESENTATION &amp; RUNTIME</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>React 19 &amp; TypeScript</strong>
                                        <span>Executive terminal, component hierarchy, custom reactive state</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Tailwind CSS v4 &amp; Motion</strong>
                                        <span>Dark glassmorphic finance UI, cash flow charts, smooth animations</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Electron Desktop Shell</strong>
                                        <span>Cross-platform desktop packaging, NSIS Windows installer, local bridge</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ Financial State Actions / FX Calculation Pipeline ↓</div>

                            <div class="diag-layer layer-services">
                                <span class="layer-pill">2. APPLICATION SERVICES &amp; FINANCIAL LOGIC</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Multi-Currency FX Engine</strong>
                                        <span>Real-time conversion across EGP, USD, EUR with locked invoice rates</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Client CRM &amp; Milestone Engine</strong>
                                        <span>Contract terms (Net 15/30/60), retainers, deliverable lifecycles</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>jsPDF Document Generator</strong>
                                        <span>Client-side PDF invoicing with banking &amp; wire remittance coordinates</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Cash Flow &amp; Burn-Rate Analyzer</strong>
                                        <span>Double-entry ledger reconciliation, 30-day runway projection</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ Client-Side Local Storage &amp; File I/O ↓</div>

                            <div class="diag-layer layer-data">
                                <span class="layer-pill">3. ZERO-CLOUD LOCAL PERSISTENCE</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Isolated LocalStorage Schema</strong>
                                        <span>Entities for clients, invoices, milestones, and cash flow entries</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>JSON Backup &amp; Migration Engine</strong>
                                        <span>One-click export/import for effortless workstation synchronization</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Zero-Telemetry Privacy Core</strong>
                                        <span>100% offline data sovereignty with zero external API dependencies</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════ ALKIAN ALSAAMY ═══════════ *@
                        else if (IsSlug("alkian-alsaamy"))
                        {
                            <div class="diag-layer layer-presentation">
                                <span class="layer-pill">1. CLIENT-SIDE PRESENTATION &amp; CAROUSELS</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>HTML5 &amp; Bootstrap 5</strong>
                                        <span>Responsive grid system, fluid layout, mobile-first navigation</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Owl Carousel 2 &amp; WOW.js</strong>
                                        <span>Multi-slide service carousels, banner animations, smooth scroll</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Agency Visual Assets</strong>
                                        <span>High-converting hero illustration, vector branding, service iconography</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ Interactive Client Interactions &amp; Geolocation Embed ↓</div>

                            <div class="diag-layer layer-services">
                                <span class="layer-pill">2. SERVICE SHOWCASE &amp; LEAD CAPTURE</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Paid Ad Services Showcase</strong>
                                        <span>Google, Meta &amp; TikTok campaign strategies, audience targeting</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Interactive Lead Ingestion</strong>
                                        <span>Multi-field inquiry capture, client telephone routing, email dispatch</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Google Maps Geolocation</strong>
                                        <span>Dubai/UAE agency headquarters embedded viewport</span>
                                    </div>
                                </div>
                            </div>

                            <div class="diagram-arrow">↓ CDN &amp; High-Availability Web Hosting ↓</div>

                            <div class="diag-layer layer-data">
                                <span class="layer-pill">3. HOSTING &amp; ASSET INFRASTRUCTURE</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>High-Speed Static Hosting</strong>
                                        <span>Optimized asset delivery, TLS encryption, edge caching</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Global CDN Pipelines</strong>
                                        <span>Google Fonts (Poppins), Font Awesome 5, Bootstrap CDN assets</span>
                                    </div>
                                    <div class="diag-box">
                                        <strong>Social Media Deep-Links</strong>
                                        <span>Direct WhatsApp &amp; Instagram communication bridges</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ═══════════ FALLBACK ═══════════ *@
                        else
                        {
                            <div class="diag-layer layer-presentation">
                                <span class="layer-pill">1. PRESENTATION TIER</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Front-End Layer</strong>
                                        <span>UI components, user interactions</span>
                                    </div>
                                </div>
                            </div>
                            <div class="diagram-arrow">↓ Request / Response ↓</div>
                            <div class="diag-layer layer-services">
                                <span class="layer-pill">2. APPLICATION LOGIC</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Business Services</strong>
                                        <span>Core features and integrations</span>
                                    </div>
                                </div>
                            </div>
                            <div class="diagram-arrow">↓ Data Operations ↓</div>
                            <div class="diag-layer layer-data">
                                <span class="layer-pill">3. DATA LAYER</span>
                                <div class="layer-boxes">
                                    <div class="diag-box">
                                        <strong>Data Storage</strong>
                                        <span>Persistence and retrieval</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "database")
            {
                <div class="database-erd-view">
                    <div class="erd-grid">
                        @if (IsSlug("tech-xpress"))
                        {
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">Products</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> Id (int)</li>
                                    <li>Title (nvarchar)</li>
                                    <li>Price (decimal)</li>
                                    <li>Description (nvarchar)</li>
                                    <li class="col-fk"><b>FK</b> CategoryId (int)</li>
                                    <li>ImageUrl (nvarchar)</li>
                                </ul>
                            </div>

                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">Orders</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> Id (int)</li>
                                    <li class="col-fk"><b>FK</b> ApplicationUserId (nvarchar)</li>
                                    <li>OrderDate (datetime2)</li>
                                    <li>OrderTotal (decimal)</li>
                                    <li>OrderStatus (nvarchar)</li>
                                    <li>PaymentIntentId (nvarchar)</li>
                                </ul>
                            </div>

                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">OrderDetails</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> Id (int)</li>
                                    <li class="col-fk"><b>FK</b> OrderId (int)</li>
                                    <li class="col-fk"><b>FK</b> ProductId (int)</li>
                                    <li>Count (int)</li>
                                    <li>Price (decimal)</li>
                                </ul>
                            </div>

                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">Categories</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> Id (int)</li>
                                    <li>Name (nvarchar)</li>
                                    <li>DisplayOrder (int)</li>
                                </ul>
                            </div>
                        }
                        else if (IsSlug("elearning"))
                        {
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">Courses</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> Id (int)</li>
                                    <li>Title (nvarchar)</li>
                                    <li>Track (nvarchar)</li>
                                    <li class="col-fk"><b>FK</b> InstructorId (nvarchar)</li>
                                </ul>
                            </div>
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">ChatbotInteractions</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> Id (int)</li>
                                    <li class="col-fk"><b>FK</b> StudentId (nvarchar)</li>
                                    <li>UserPrompt (nvarchar)</li>
                                    <li>BotResponse (nvarchar)</li>
                                    <li>Timestamp (datetime2)</li>
                                </ul>
                            </div>
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">LearningPaths</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> Id (int)</li>
                                    <li>PathName (nvarchar)</li>
                                    <li class="col-fk"><b>FK</b> CourseId (int)</li>
                                    <li>SortOrder (int)</li>
                                </ul>
                            </div>
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">Books</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> Id (int)</li>
                                    <li>Title (nvarchar)</li>
                                    <li>Author (nvarchar)</li>
                                    <li class="col-fk"><b>FK</b> CategoryId (int)</li>
                                    <li>FileUrl (nvarchar)</li>
                                </ul>
                            </div>
                        }
                        else if (IsSlug("rawafid"))
                        {
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">articles</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> id (int)</li>
                                    <li>title (varchar)</li>
                                    <li>body (text)</li>
                                    <li class="col-fk"><b>FK</b> category_id (int)</li>
                                    <li class="col-fk"><b>FK</b> author_id (int)</li>
                                    <li>published_at (datetime)</li>
                                    <li>lang (varchar)</li>
                                </ul>
                            </div>
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">categories</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> id (int)</li>
                                    <li>name_ar (varchar)</li>
                                    <li>name_en (varchar)</li>
                                    <li>slug (varchar)</li>
                                </ul>
                            </div>
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">events</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> id (int)</li>
                                    <li>title (varchar)</li>
                                    <li>description (text)</li>
                                    <li>event_date (datetime)</li>
                                    <li>location (varchar)</li>
                                </ul>
                            </div>
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">users</span>
                                    <span class="erd-badge">Table</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> id (int)</li>
                                    <li>username (varchar)</li>
                                    <li>email (varchar)</li>
                                    <li>password_hash (varchar)</li>
                                    <li>role (enum)</li>
                                </ul>
                            </div>
                        }
                        else if (IsSlug("deverp"))
                        {
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">Clients</span>
                                    <span class="erd-badge">Entity</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> id (string/uuid)</li>
                                    <li>name (string)</li>
                                    <li>company (string)</li>
                                    <li>email (string)</li>
                                    <li>paymentTerms (Net15/30/60)</li>
                                    <li>currency (EGP/USD/EUR)</li>
                                </ul>
                            </div>
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">Invoices</span>
                                    <span class="erd-badge">Entity</span>
                                </div>
                                <ul class="erd-cols">
                                    <li class="col-pk"><b>PK</b> id (string)</li>
                                    <li>invoiceNumber (INV-YYYY-XXX)</li>
                                    <li class="col-fk"><b>FK</b> clientId (string)</li>
                                    <li>issueDate (ISO string)</li>
                                    <li>dueDate (ISO string)</li>
                                    <li>currency (string)</li>
                                    <li>fxRateToBase (decimal)</li>
                                    <li>totalAmount (decimal)</li>
                                    <li>status (Draft/Sent/Settled)</li>
                                </ul>
                            </div>
                            <div class="erd-table">
                                <div class="erd-table-head">
                                    <span class="erd-name">Milestones</span>
                                    <span class="erd-badge">Entity</span>
