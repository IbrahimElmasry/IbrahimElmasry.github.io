import jsPDF from 'jspdf';
import { Invoice, Client, ExchangeRates } from '../types';

export function generateInvoicePdf(invoice: Invoice, client: Client, rates: ExchangeRates): jsPDF {
  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
  const baseCurrency = 'EGP';
  const fxMultiplier = rates[invoice.currency] || 1.0;
  const totalInBase = invoice.totalAmount * fxMultiplier;

  // Header & Executive Terminal Branding
  doc.setFillColor(15, 23, 42); // slate-900
  doc.rect(0, 0, 210, 36, 'F');
  doc.setTextColor(248, 250, 252);
  doc.setFontSize(20);
  doc.text('DevERP · EXECUTIVE INVOICE', 14, 22);

  // Remittance & Banking Coordinates (IBAN / SWIFT)
  doc.setFontSize(9);
  doc.setTextColor(148, 163, 184);
  doc.text(`Invoice ID: ${invoice.invoiceNumber}`, 140, 16);
  doc.text(`Issue Date: ${invoice.issueDate}`, 140, 22);
  doc.text(`Due Date: ${invoice.dueDate} (${client.paymentTerms})`, 140, 28);

  // Client Bill-To
  doc.setTextColor(30, 41, 59);
  doc.setFontSize(11);
  doc.text('BILLED TO:', 14, 48);
  doc.setFontSize(10);
  doc.text(`${client.name} — ${client.company}`, 14, 55);
  doc.text(`Contact: ${client.email}`, 14, 61);

  // Line items and FX conversion table
  let y = 80;
  invoice.items.forEach((item, index) => {
    doc.text(`${index + 1}. ${item.description}`, 14, y);
    doc.text(`${invoice.currency} ${item.amount.toLocaleString()}`, 170, y, { align: 'right' });
    y += 10;
  });

  // Locked Multi-Currency Settlement
  doc.line(14, y + 2, 196, y + 2);
  doc.setFontSize(12);
  doc.text(`Total Due (${invoice.currency}):`, 120, y + 12);
  doc.text(`${invoice.currency} ${invoice.totalAmount.toLocaleString()}`, 196, y + 12, { align: 'right' });
  doc.setFontSize(9);
  doc.setTextColor(100, 116, 139);
  doc.text(`Reporting Base: E£ ${totalInBase.toLocaleString(undefined, { minimumFractionDigits: 2 })} (FX: ${fxMultiplier})`, 120, y + 18);

  return doc;
}";

