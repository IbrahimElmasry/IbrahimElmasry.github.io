// Multilingual Article Routing – ArticleController.php

class ArticleController
{
    private PDO $db;

    public function __construct(PDO $db)
    {
        $this->db = $db;
    }

    public function index(string $lang = 'ar'): void
    {
        $stmt = $this->db->prepare(
            'SELECT a.*, c.name_' . $lang . ' AS category_name
             FROM articles a
             JOIN categories c ON a.category_id = c.id
             WHERE a.lang = :lang
             ORDER BY a.published_at DESC'
        );
        $stmt->execute(['lang' => $lang]);
        $articles = $stmt->fetchAll(PDO::FETCH_ASSOC);

        include __DIR__ . ""/../views/{$lang}/articles/index.php"";
    }

    public function show(int $id): void
    {
        $stmt = $this->db->prepare(
            'SELECT * FROM articles WHERE id = :id'
        );
        $stmt->execute(['id' => $id]);
        $article = $stmt->fetch(PDO::FETCH_ASSOC);

        include __DIR__ . ""/../views/{$article['lang']}/articles/show.php"";
    }
}";

