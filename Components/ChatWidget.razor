    private string FormatMessageText(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "";

        var formatted = raw
            .Replace("\n\n", "<br /><br />")
            .Replace("\n", "<br />");

        while (formatted.Contains("**"))
        {
            var first = formatted.IndexOf("**", StringComparison.Ordinal);
            var second = formatted.IndexOf("**", first + 2, StringComparison.Ordinal);
            if (second == -1) break;
            formatted = formatted.Substring(0, first) + "<strong>" + formatted.Substring(first + 2, second - first - 2) + "</strong>" + formatted.Substring(second + 2);
        }

        while (formatted.Contains('`'))
        {
            var first = formatted.IndexOf('`');
            var second = formatted.IndexOf('`', first + 1);
            if (second == -1) break;
            formatted = formatted.Substring(0, first) + "<code class=\"chat-inline-code\">" + formatted.Substring(first + 1, second - first - 1) + "</code>" + formatted.Substring(second + 1);
        }

        return formatted;
    }

