@inject ContentService Content
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http
@implements IDisposable

<div class="chat-widget-container">
    @if (!isOpen)
    {
        <!-- Floating Chat Launcher Button -->
        <button type="button"
                class="chat-launcher-btn"
                @onclick="ToggleChat"
                aria-label="Open Ibrahim AI Assistant">
            <span class="launcher-pulse"></span>
            <span class="launcher-icon">✦</span>
            <span class="launcher-text">Ask Ibrahim AI</span>
            <span class="launcher-badge">Online</span>
        </button>
    }
    else
    {
        <!-- Chat Popup Window -->
        <div class="chat-window @(isWidescreen ? "is-widescreen" : "")" role="dialog" aria-labelledby="chat-title">
            <div class="chat-header">
                <div class="chat-header-info">
                    <div class="chat-avatar">
                        <span class="avatar-letters">IA</span>
                        <span class="online-indicator"></span>
                    </div>
                    <div class="chat-header-text">
                        <div class="chat-header-title-row">
                            <span id="chat-title" class="chat-header-name">Ibrahim AI</span>
                            <span class="chat-model-badge">
                                <span class="model-badge-dot"></span>
                                @(useGemini && !string.IsNullOrEmpty(geminiApiKey) ? "GEMINI" : "ASSISTANT")
                            </span>
                        </div>
                        <span class="chat-header-status">
                            @(selectedPersona switch {
                                "recruiter" => "Recruiter Mode · Executive Brief",
                                "architect" => "Tech Lead Mode · Architecture",
                                "client" => "Client Mode · Delivery & ROI",
                                _ => "ASP.NET Core & Cloud Specialist"
                            })
                        </span>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <!-- Dropdown Menu for Auxiliary Actions -->
                    <div class="chat-menu-wrapper">
                        <button type="button" 
                                class="chat-action-btn @(showMenu ? "is-active" : "")" 
                                @onclick="ToggleMenu" 
                                title="Conversation options">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="1.5"></circle>
                                <circle cx="19" cy="12" r="1.5"></circle>
                                <circle cx="5" cy="12" r="1.5"></circle>
                            </svg>
                        </button>
                        @if (showMenu)
                        {
                            <div class="chat-dropdown-menu">
                                <button type="button" class="chat-menu-item" @onclick="() => { ToggleSettings(); showMenu = false; }">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                    <span>AI Key (Gemini)</span>
                                </button>
                                <button type="button" class="chat-menu-item" @onclick="async () => { await CopyTranscript(); showMenu = false; }">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                    <span>@(isCopied ? "Copied!" : "Copy Chat")</span>
                                </button>
                                <button type="button" class="chat-menu-item" @onclick="async () => { await DownloadCandidateBrief(); showMenu = false; }">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                    <span>Export Brief (.md)</span>
                                </button>
                                <div class="chat-menu-divider"></div>
                                <button type="button" class="chat-menu-item chat-menu-danger" @onclick="() => { ClearChat(); showMenu = false; }">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                                    <span>Reset Conversation</span>
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Expand / Widescreen View Button -->
                    <button type="button" 
                            class="chat-action-btn" 
                            @onclick="ToggleWidescreen" 
                            title="@(isWidescreen ? "Normal view" : "Expand to widescreen")">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            @if (isWidescreen)
                            {
                                <polyline points="4 14 10 14 10 20"></polyline>
                                <polyline points="20 10 14 10 14 4"></polyline>
                                <line x1="14" y1="10" x2="21" y2="3"></line>
                                <line x1="3" y1="21" x2="10" y2="14"></line>
                            }
                            else
                            {
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <polyline points="9 21 3 21 3 15"></polyline>
                                <line x1="21" y1="3" x2="14" y2="10"></line>
                                <line x1="3" y1="21" x2="10" y2="14"></line>
                            }
                        </svg>
                    </button>

                    <!-- Close Button -->
                    <button type="button" 
                            class="chat-action-btn chat-close-btn" 
                            @onclick="ToggleChat" 
                            title="Close Chat">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Optional Gemini Settings Panel -->
            @if (showSettings)
            {
                <div class="chat-settings-panel">
                    <div class="settings-header">
                        <span>✦ Hybrid Gemini AI Configuration</span>
                        <button type="button" class="chat-action-btn" @onclick="ToggleSettings">✕</button>
                    </div>
                    <p style="margin: 0; color: #a4b2b8; font-size: 10.5px;">Enter a Google Gemini API Key to enable open-ended generative LLM reasoning, or leave blank to use the instant local Knowledge Engine.</p>
                    <div class="settings-input-group">
                        <input type="password" 
                               class="settings-input" 
                               placeholder="AIzaSy..." 
                               @bind="geminiApiKey" />
                        <button type="button" class="settings-save-btn" @onclick="SaveGeminiKey">Save</button>
                    </div>
                    <span class="settings-note">Key is stored locally in your browser session only.</span>
                </div>
            }

            <!-- Modern Segmented Persona Switcher Bar -->
            <div class="chat-persona-bar">
                <button type="button" 
                        class="chat-persona-btn @(selectedPersona == "general" ? "is-active" : "")"
                        @onclick='() => SetPersona("general")'>
                    <span class="persona-dot"></span>
                    <span>General</span>
                </button>
                <button type="button" 
                        class="chat-persona-btn @(selectedPersona == "recruiter" ? "is-active" : "")"
                        @onclick='() => SetPersona("recruiter")'>
                    <span class="persona-dot"></span>
                    <span>Recruiter</span>
                </button>
                <button type="button" 
                        class="chat-persona-btn @(selectedPersona == "architect" ? "is-active" : "")"
                        @onclick='() => SetPersona("architect")'>
                    <span class="persona-dot"></span>
                    <span>Tech Lead</span>
                </button>
                <button type="button" 
                        class="chat-persona-btn @(selectedPersona == "client" ? "is-active" : "")"
                        @onclick='() => SetPersona("client")'>
                    <span class="persona-dot"></span>
                    <span>Client</span>
                </button>
            </div>

            <!-- Messages Area -->
            <div class="chat-messages" id="chat-messages-container">
                @foreach (var msg in messages)
                {
                    <div class="chat-message-row @(msg.IsUser ? "msg-user" : "msg-ai")">
                        @if (!msg.IsUser)
                        {
                            <span class="msg-avatar">✦</span>
                        }
                        <div class="chat-bubble">
                            <div class="chat-bubble-text">
                                @((MarkupString)FormatMessageText(msg.Text))
                            </div>

                            <!-- Interactive C# Code Snippet Card -->
                            @if (msg.CodeSnippet != null)
                            {
                                <div class="chat-code-card">
                                    <div class="chat-code-header">
                                        <span>💻 @msg.CodeSnippet.Title</span>
                                        <button type="button" 
                                                class="chat-code-copy-btn" 
                                                @onclick="() => CopyCode(msg.CodeSnippet.Code)">
                                            📋 Copy Code
                                        </button>
                                    </div>
                                    <pre class="chat-code-body"><code>@msg.CodeSnippet.Code</code></pre>
                                </div>
                            }

                            <!-- Interactive Estimator Step Box -->
                            @if (msg.EstimatorStep > 0 && !msg.IsUser)
                            {
                                <div class="chat-estimator-box">
                                    @if (msg.EstimatorStep == 1)
                                    {
                                        <div class="estimator-step-title">
                                            <span class="estimator-step-badge">STEP 1/3</span>
                                            <span>Select Project Architecture:</span>
                                        </div>
                                        <div class="estimator-options-grid">
                                            <button type="button" class="estimator-opt-btn" @onclick='() => HandleEstimatorStep(2, "E-Commerce System (Stripe & Catalog)")'>
                                                🛒 Production E-Commerce Platform
                                            </button>
                                            <button type="button" class="estimator-opt-btn" @onclick='() => HandleEstimatorStep(2, "High-Performance REST Web API (Clean Arch)")'>
                                                ⚡ Enterprise ASP.NET Core Web API
                                            </button>
                                            <button type="button" class="estimator-opt-btn" @onclick='() => HandleEstimatorStep(2, "Full-Stack Portal (Blazor / MVC + SQL)")'>
                                                🌐 Full-Stack Corporate Portal
                                            </button>
                                        </div>
                                    }
                                    else if (msg.EstimatorStep == 2)
                                    {
                                        <div class="estimator-step-title">
                                            <span class="estimator-step-badge">STEP 2/3</span>
                                            <span>Select Key Requirements:</span>
                                        </div>
                                        <div class="estimator-options-grid">
                                            <button type="button" class="estimator-opt-btn" @onclick='() => HandleEstimatorStep(3, "Secure Payment Webhooks & Role-based Auth")'>
                                                🔐 Stripe Checkout & ASP.NET Identity
                                            </button>
                                            <button type="button" class="estimator-opt-btn" @onclick='() => HandleEstimatorStep(3, "High-Concurrency CQRS with Redis Caching")'>
                                                🚀 CQRS + Redis Cache + Micro-benchmarks
                                            </button>
                                            <button type="button" class="estimator-opt-btn" @onclick='() => HandleEstimatorStep(3, "AI LLM Integration & Document Assistant")'>
                                                🤖 Intelligent AI Integration & Retrieval
                                            </button>
                                        </div>
                                    }
                                    else if (msg.EstimatorStep == 3)
                                    {
                                        <div class="estimator-step-title">
                                            <span class="estimator-step-badge">STEP 3/3</span>
                                            <span>Target Launch Timeline:</span>
                                        </div>
                                        <div class="estimator-options-grid">
                                            <button type="button" class="estimator-opt-btn" @onclick='() => FinishEstimator("1 to 2 Months (Rapid MVP)")'>
                                                ⚡ Rapid MVP (1–2 Months)
                                            </button>
                                            <button type="button" class="estimator-opt-btn" @onclick='() => FinishEstimator("2 to 4 Months (Full Enterprise)")'>
                                                🏗️ Enterprise Scale (2–4 Months)
                                            </button>
                                            <button type="button" class="estimator-opt-btn" @onclick='() => FinishEstimator("Flexible / Ongoing Advisory")'>
                                                🔄 Flexible / Technical Advisory
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Action Pills -->
                            @if (msg.Actions.Count > 0)
                            {
                                <div class="msg-actions-grid">
                                    @foreach (var action in msg.Actions)
                                    {
                                        @if (action.Url.StartsWith("#"))
                                        {
                                            <button type="button" class="msg-action-pill" @onclick="() => NavigateAndHighlight(action.Url)">
                                                <span>@action.Label</span>
                                                <span class="action-icon">↘</span>
                                            </button>
                                        }
                                        else if (action.Url.StartsWith("http"))
                                        {
                                            <a href="@action.Url" target="_blank" rel="noreferrer" class="msg-action-pill">
                                                <span>@action.Label</span>
                                                <span class="action-icon">↗</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@action.Url" class="msg-action-pill">
                                                <span>@action.Label</span>
                                                <span class="action-icon">↗</span>
                                            </a>
                                        }
                                    }
                                </div>
                            }

                            <div class="chat-bubble-footer">
                                @if (!msg.IsUser)
                                {
                                    <button type="button" 
                                            class="chat-speak-btn @(activeSpeakingId == msg.Id ? "is-speaking" : "")" 
                                            @onclick="() => ToggleSpeech(msg)" 
                                            title="Read answer aloud">
                                        @(activeSpeakingId == msg.Id ? "⏹ Stop" : "🔊 Listen")
                                    </button>
                                }
                                <span class="msg-time">@msg.Timestamp.ToString("h:mm tt")</span>
                            </div>
                        </div>
                    </div>
                }

                @if (isTyping)
                {
                    <div class="chat-message-row msg-ai">
                        <span class="msg-avatar">✦</span>
                        <div class="chat-bubble typing-bubble">
                            <div class="typing-dots">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Dynamic Suggestion Chips -->
            @if (!isTyping && activeSuggestions.Count > 0)
            {
                <div class="chat-suggestions">
                    <span class="suggestions-label">SUGGESTED QUERIES</span>
                    <div class="suggestions-scroll">
                        @foreach (var suggestion in activeSuggestions)
                        {
                            <button type="button" class="suggestion-chip" @onclick="() => SendPrompt(suggestion)">
                                @suggestion
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Input Bar with Voice Recognition -->
            <form class="chat-input-bar" @onsubmit="SendMessage" @onsubmit:preventDefault>
                <button type="button" 
                        class="chat-mic-btn @(isListening ? "is-listening" : "")" 
                        @onclick="ToggleVoiceRecognition" 
                        title="@(isListening ? "Listening... click to stop" : "Speak question (Voice Mode)")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                        <line x1="12" y1="19" x2="12" y2="23"></line>
                        <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                </button>
                <input type="text"
                       class="chat-input-field"
                       placeholder="@(isListening ? "Listening to your voice..." : "Ask in English or Arabic (skills, projects, code)...")"
                       @bind="userInput"
                       @bind:event="oninput"
                       disabled="@isTyping" />
                <button type="submit"
                        class="chat-send-btn"
                        disabled="@(string.IsNullOrWhiteSpace(userInput) || isTyping)"
                        aria-label="Send message">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </form>
        </div>
    }
</div>

@code {
    private bool isOpen;
    private bool isTyping;
    private bool isWidescreen;
    private bool isCopied;
    private bool isListening;
    private bool showSettings;
    private bool showMenu;
    private bool useGemini;
    private string geminiApiKey = "";
    private string selectedPersona = "general";
    private string userInput = "";
    private string? activeSpeakingId;

    private DotNetObjectReference<ChatWidget>? dotNetRef;
    private readonly List<ChatMessage> messages = [];
    private List<string> activeSuggestions = [];

    private Profile profile = new();
    private List<Project> projects = [];
    private List<Testimonial> testimonials = [];
    private List<Certificate> certificates = [];

    // Temporary storage for 3-step project estimator
    private string estimatorProjectType = "";
    private string estimatorRequirements = "";

    public sealed record ChatCodeSnippet(string Title, string Code);
    public sealed record ChatAction(string Label, string Url);
    public sealed record ChatMessage(string Id, string Text, bool IsUser, DateTime Timestamp, List<ChatAction> Actions, ChatCodeSnippet? CodeSnippet = null, int EstimatorStep = 0);

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            profile = await Content.GetProfileAsync();
            projects = await Content.GetProjectsAsync();
            testimonials = await Content.GetTestimonialsAsync();
            certificates = await Content.GetCertificatesAsync();
        }
        catch
        {
            // Fallback
        }

        if (messages.Count == 0)
        {
            messages.Add(new ChatMessage(
                Guid.NewGuid().ToString(),
                "Hello! I am **Ibrahim's AI Knowledge Assistant**.\n\nAsk me about his **ASP.NET Core & C# engineering**, explore his **production architectures & live projects**, review his **verified certificates**, or try the **Interactive Project Estimator**.",
                false,
                DateTime.Now,
                new List<ChatAction>
                {
                    new("Book 1:1 Call 🗓️", "book-a-call"),
                    new("View Certificates 📜", "#certifications"),
                    new("Estimate My Project 🧮", "ESTIMATE_FLOW")
                }
            ));
        }

        UpdateSuggestionsForPersona();
    }

    private void SetPersona(string persona)
    {
        selectedPersona = persona;
        UpdateSuggestionsForPersona();
        messages.Add(new ChatMessage(
            Guid.NewGuid().ToString(),
            persona switch
            {
                "recruiter" => "Switched to **Recruiter Mode 💼**. Answers will focus on executive credentials, years of experience, hiring availability, and key achievements.",
                "architect" => "Switched to **Tech Lead / Architect Mode 🛠️**. Answers will deep-dive into Clean Architecture, CQRS, EF Core compiled queries, memory efficiency, and threading.",
                "client" => "Switched to **Client & Founder Mode 🤝**. Answers will focus on project turnaround times, business ROI, payment integrations, and delivery reliability.",
                _ => "Switched to **General Mode ✦**. Balanced portfolio overview."
            },
            false,
            DateTime.Now,
            new List<ChatAction>
            {
                new("Book 1:1 Call 🗓️", "book-a-call"),
                new("View Certificates 📜", "#certifications")
            }
        ));
        ScrollToBottom();
    }

    private void UpdateSuggestionsForPersona()
    {
        activeSuggestions = selectedPersona switch
        {
            "recruiter" =>
            [
                "What is his hiring availability?",
                "What certificates does he have?",
                "Who gave verified testimonials?",
                "Download Resume 📄",
                "How to book a 1:1 interview?"
            ],
            "architect" =>
            [
                "Show CQRS & MediatR C# code 💻",
                "Explain the 4-layer architecture",
                "EF Core performance & indexing rules",
                "Show Global Exception Handler code 💻",
                "Tell me about Tech Xpress architecture"
            ],
            "client" =>
            [
                "Estimate My Project 🧮",
                "What was the turnaround for El-Wakeel?",
                "How does Stripe payment work?",
                "What are client reviews & feedback?",
                "Schedule a 60-min discussion"
            ],
            _ =>
            [
                "What are Ibrahim's core skills?",
                "What certificates does he hold?",
                "Who gave testimonials & feedback?",
                "Show CQRS code snippet 💻",
                "Estimate My Project 🧮",
                "ما هي مهارات إبراهيم؟"
            ]
        };
    }

    public void Open()
    {
        isOpen = true;
        StateHasChanged();
        ScrollToBottom();
    }

    private void ToggleChat()
    {
        isOpen = !isOpen;
        showMenu = false;
        if (isOpen) ScrollToBottom();
    }

    private void ToggleMenu() => showMenu = !showMenu;
    private void ToggleWidescreen() => isWidescreen = !isWidescreen;
    private void ToggleSettings() => showSettings = !showSettings;

    private async Task SaveGeminiKey()
    {
        useGemini = !string.IsNullOrWhiteSpace(geminiApiKey);
        showSettings = false;
        messages.Add(new ChatMessage(
            Guid.NewGuid().ToString(),
            useGemini 
                ? "✨ **Hybrid Gemini Mode Activated!** Questions will now leverage Google's Gemini LLM with Ibrahim's portfolio system prompt." 
                : "Switched back to the instant **Local Knowledge Engine**.",
            false,
            DateTime.Now,
            []
        ));
        ScrollToBottom();
    }

    [JSInvokable]
    public void OnSpeechResult(string transcript)
    {
        userInput = transcript;
        isListening = false;
        StateHasChanged();
        _ = SendMessage();
    }

    [JSInvokable]
    public void OnSpeechStateChanged(bool listening)
    {
        isListening = listening;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeakingStateChanged(bool speaking)
    {
        if (!speaking) activeSpeakingId = null;
        StateHasChanged();
    }

    private async Task ToggleVoiceRecognition()
    {
        if (isListening)
        {
            await JS.InvokeVoidAsync("portfolioSpeech.stopListening");
            isListening = false;
        }
        else
        {
            if (dotNetRef != null)
            {
                await JS.InvokeVoidAsync("portfolioSpeech.startListening", dotNetRef);
            }
        }
    }

    private async Task ToggleSpeech(ChatMessage msg)
    {
        if (activeSpeakingId == msg.Id)
        {
            await JS.InvokeVoidAsync("portfolioSpeech.stopSpeaking", dotNetRef);
            activeSpeakingId = null;
        }
        else
        {
            activeSpeakingId = msg.Id;
            await JS.InvokeVoidAsync("portfolioSpeech.speak", msg.Text, dotNetRef);
        }
    }

    private async Task NavigateAndHighlight(string url)
    {
        if (url == "ESTIMATE_FLOW")
        {
            StartEstimatorFlow();
            return;
        }

        await JS.InvokeVoidAsync("portfolioScrollAndHighlight", url);
    }

    private async Task CopyCode(string code)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
    }

    private async Task CopyTranscript()
    {
        if (isCopied) return;
        var transcript = string.Join("\n\n", messages.Select(m => $"{(m.IsUser ? "User" : "Ibrahim AI")}: {m.Text}"));
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", transcript);
