    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isTyping) return;

        var text = userInput.Trim();
        userInput = "";
        messages.Add(new ChatMessage(Guid.NewGuid().ToString(), text, true, DateTime.Now, []));
        ScrollToBottom();

        isTyping = true;
        StateHasChanged();

        if (text.Equals("ESTIMATE_FLOW", StringComparison.OrdinalIgnoreCase) || text.Contains("estimate", StringComparison.OrdinalIgnoreCase) && text.Contains("project"))
        {
            await Task.Delay(350);
            StartEstimatorFlow();
            isTyping = false;
            StateHasChanged();
            return;
        }

        // Check if Gemini Hybrid is active
        if (useGemini && !string.IsNullOrWhiteSpace(geminiApiKey))
        {
            var geminiReply = await CallGeminiAsync(text);
            if (!string.IsNullOrEmpty(geminiReply))
            {
                messages.Add(new ChatMessage(
                    Guid.NewGuid().ToString(),
                    geminiReply,
                    false,
                    DateTime.Now,
                    new List<ChatAction>
                    {
                        new("Book 1:1 Call 🗓️", "book-a-call"),
                        new("View Certificates 📜", "#certifications")
                    }
                ));
                isTyping = false;
                StateHasChanged();
                ScrollToBottom();
                return;
            }
        }

        // Knowledge Engine
        await Task.Delay(420);
        var (reply, actions, snippet) = GenerateResponse(text);
        messages.Add(new ChatMessage(Guid.NewGuid().ToString(), reply, false, DateTime.Now, actions, snippet));
        isTyping = false;
        StateHasChanged();
        ScrollToBottom();
    }

    private async Task<string?> CallGeminiAsync(string prompt)
    {
        try
        {
            var systemPrompt = $"You are Ibrahim Tarek's AI Assistant on his portfolio website. Ibrahim is an ASP.NET Core and .NET backend developer in Alexandria, Egypt. He specializes in C#, Clean Architecture, CQRS, EF Core, and SQL Server. He has a Google Cybersecurity Professional Certificate, DEPI 6-month scholarship, and an Excellent grade on his AI E-Learning graduation project. Testimonials from Dr. Fifi Farouk, Eng. Mohamed Abdullah, Mr. Abdullah El-Wakeel. Be professional, concise, enthusiastic, and helpful. Inquirer asked: {prompt}";

            var body = new
            {
                contents = new[]
                {
                    new { role = "user", parts = new[] { new { text = systemPrompt } } }
                }
            };

            var response = await Http.PostAsJsonAsync($"https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={geminiApiKey}", body);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                return json.GetProperty("candidates")[0].GetProperty("content").GetProperty("parts")[0].GetProperty("text").GetString();
            }
        }
        catch { }
        return null;
    }

