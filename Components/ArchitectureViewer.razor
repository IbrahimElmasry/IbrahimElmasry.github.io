@inject LanguageService Lang

<div class="arch-viewer-card" id="architecture-viewer">
    <div class="arch-viewer-header">
        <div class="arch-badge">
            <span class="badge-dot"></span>
            <span>@(Lang.IsArabic ? "مخططات المعمارية وقواعد البيانات (ERD)" : "SYSTEM TOPOLOGY & DATABASE SCHEMAS")</span>
        </div>
        <div class="arch-heading-row">
            <div>
                <h3 class="arch-title">
                    @(Lang.IsArabic ? "معمارية الأنظمة ومخططات " : "Interactive Architecture & ")
                    <em>ERD Viewer</em>
                </h3>
                <p class="arch-subtitle">
                    @(Lang.IsArabic ? "استعرض المعمارية الهندسية، وفصل الطبقات (Clean Architecture)، ومخططات قواعد البيانات العلائقية لأبرز المشاريع مع سجلات القرارات الهندسية (ADRs)." : "Deep-dive into multi-tier software design, Clean Architecture boundaries, and relational ERDs with production Architecture Decision Records (ADRs).")
                </p>
            </div>
            <!-- Project selector -->
            <div class="project-pill-selector">
                @foreach (var proj in Projects)
                {
                    <button type="button" 
                            class="proj-select-pill @(selectedProject.Id == proj.Id ? "active" : "")" 
                            @onclick="() => SelectProject(proj)">
                        <span>@proj.Icon</span>
                        <span>@proj.Name</span>
                    </button>
                }
            </div>
        </div>

        <!-- View mode tabs -->
        <div class="viewer-mode-tabs">
            <button type="button" class="mode-tab-btn @(activeMode == "topology" ? "active" : "")" @onclick='() => activeMode = "topology"'>
                <span>✦</span> @(Lang.IsArabic ? "طبقات النظام (Layers)" : "System Layers & Topology")
            </button>
            <button type="button" class="mode-tab-btn @(activeMode == "erd" ? "active" : "")" @onclick='() => activeMode = "erd"'>
                <span>⌁</span> @(Lang.IsArabic ? "مخطط قاعدة البيانات (ERD)" : "Database Schema (ERD)")
            </button>
            <button type="button" class="mode-tab-btn @(activeMode == "adr" ? "active" : "")" @onclick='() => activeMode = "adr"'>
                <span>⚖</span> @(Lang.IsArabic ? "القرارات الهندسية (ADRs)" : "Architectural Decisions (ADRs)")
            </button>
        </div>
    </div>

    <div class="arch-viewer-body">
        @if (activeMode == "topology")
        {
            <div class="topology-stage">
                <div class="topology-grid">
                    @foreach (var layer in selectedProject.Layers)
                    {
                        <div class="topo-layer-card" style="border-left: 3px solid @layer.AccentColor">
                            <div class="layer-meta">
                                <span class="layer-num" style="color: @layer.AccentColor">@layer.TierNumber</span>
                                <h4>@layer.Name</h4>
                                <span class="layer-focus">@layer.KeyPattern</span>
                            </div>
                            <p class="layer-desc">@layer.Description</p>
                            <div class="layer-components">
                                <span class="micro-label">COMPONENTS &amp; ARTIFACTS:</span>
                                <div class="comp-chips">
                                    @foreach (var comp in layer.Components)
                                    {
                                        <span class="comp-chip">@comp</span>
                                    }
                                </div>
                            </div>
                            <div class="layer-footer">
                                <span class="rule-text"><strong>RULE:</strong> @layer.DependencyRule</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="dataflow-indicator">
                    <span>▼ Data Flow: Client Request ➔ Presentation ➔ Application (MediatR/CQRS) ➔ Domain ➔ Infrastructure ➔ Database ▼</span>
                </div>
            </div>
        }
        else if (activeMode == "erd")
        {
            <div class="erd-stage">
                <div class="erd-banner">
                    <div>
                        <strong>@selectedProject.DatabaseEngine Relational Schema</strong>
                        <p>@selectedProject.DatabaseDescription</p>
                    </div>
                    <span class="erd-counter">@selectedProject.Tables.Count Relational Tables</span>
                </div>

                <div class="erd-tables-grid">
                    @foreach (var table in selectedProject.Tables)
                    {
                        <div class="erd-table-box">
                            <div class="table-box-header">
                                <span class="table-icon">▦</span>
                                <strong class="table-name">@table.Name</strong>
                                <span class="table-type">@table.Category</span>
                            </div>
                            <div class="table-columns">
                                @foreach (var col in table.Columns)
                                {
                                    <div class="table-col-row @(col.IsPk ? "is-pk" : "") @(col.IsFk ? "is-fk" : "")">
                                        <span class="col-key">
                                            @if (col.IsPk) { <b title="Primary Key">PK</b> }
                                            else if (col.IsFk) { <b title="Foreign Key">FK</b> }
                                            else { <i>•</i> }
                                        </span>
                                        <span class="col-name">@col.Name</span>
                                        <span class="col-type">@col.DataType</span>
                                        @if (!string.IsNullOrWhiteSpace(col.Constraint))
                                        {
                                            <span class="col-extra">@col.Constraint</span>
                                        }
                                    </div>
                                }
                            </div>
                            @if (table.Indexes.Length > 0)
                            {
                                <div class="table-indexes">
                                    <span class="idx-label">INDEXES:</span>
                                    @foreach (var idx in table.Indexes)
                                    {
                                        <span class="idx-tag">@idx</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (activeMode == "adr")
        {
            <div class="adr-stage">
                <div class="adr-list">
                    @foreach (var adr in selectedProject.Decisions)
                    {
                        <div class="adr-card">
                            <div class="adr-card-top">
                                <div class="adr-badge">
                                    <span>ADR #@adr.Id</span>
                                    <span class="adr-status-approved">ACCEPTED</span>
                                </div>
                                <span class="adr-date">@adr.Date</span>
                            </div>
                            <h4>@adr.Title</h4>
                            
                            <div class="adr-split-grid">
                                <div class="adr-col adr-col-problem">
                                    <span class="col-label">THE PROBLEM / CONTEXT</span>
                                    <p>@adr.Context</p>
                                </div>
                                <div class="adr-col adr-col-decision">
                                    <span class="col-label">THE ARCHITECTURAL DECISION</span>
                                    <p>@adr.Decision</p>
                                </div>
                            </div>

                            <div class="adr-consequences">
                                <span class="col-label">VERIFIED PRODUCTION IMPACT</span>
                                <div class="impact-metrics-row">
                                    @foreach (var impact in adr.Impacts)
                                    {
                                        <div class="impact-metric-pill">
                                            <span class="impact-check">✓</span>
                                            <span>@impact</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
