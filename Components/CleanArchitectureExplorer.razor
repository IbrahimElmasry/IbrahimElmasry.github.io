@inject Microsoft.JSInterop.IJSRuntime JS

<div class="arch-explorer-card">
    <div class="arch-header">
        <div class="arch-badge">
            <span class="arch-badge-dot"></span>
            <span>CLEAN ARCHITECTURE &amp; CQRS</span>
        </div>
        <h3 class="arch-title">Enterprise System <em>Blueprint</em></h3>
        <p class="arch-subtitle">
            How I structure scalable, maintainable ASP.NET Core solutions using Clean Architecture, CQRS, and Domain-Driven Design principles.
        </p>
    </div>

    <!-- Interactive Layer Selection Tabs -->
    <div class="arch-layer-nav" role="tablist">
        @foreach (var layer in Layers)
        {
            <button type="button"
                    class="arch-layer-tab @(selectedLayerId == layer.Id ? "is-active" : "") @(simulatingLayerId == layer.Id ? "is-simulating" : "")"
                    @onclick="() => SelectLayer(layer.Id)">
                <span class="layer-pill" style="border-color: @layer.AccentColor; color: @layer.AccentColor">@layer.StepNumber</span>
                <span class="layer-name">@layer.Name</span>
                <span class="layer-indicator" style="background: @layer.AccentColor"></span>
            </button>
        }
    </div>

    <!-- Active Layer Deep Dive View -->
    <div class="arch-body">
        <div class="arch-main-col">
            <div class="arch-layer-header">
                <div class="arch-layer-title-wrap">
                    <span class="arch-tier-pill" style="color: @CurrentLayer.AccentColor; border-color: @(CurrentLayer.AccentColor)44; background: @(CurrentLayer.AccentColor)14;">
                        @CurrentLayer.Tier
                    </span>
                    <h4>@CurrentLayer.Name Layer</h4>
                </div>
                <div class="arch-rule-badge">
                    <span>RULE:</span> @CurrentLayer.GoldenRule
                </div>
            </div>

            <p class="arch-layer-desc">@CurrentLayer.Description</p>

            <div class="arch-patterns-grid">
                <div class="arch-block">
                    <span class="arch-block-label">CORE RESPONSIBILITIES</span>
                    <ul class="arch-list">
                        @foreach (var resp in CurrentLayer.Responsibilities)
                        {
                            <li><span>▹</span> @resp</li>
                        }
                    </ul>
                </div>

                <div class="arch-block">
                    <span class="arch-block-label">DESIGN PATTERNS &amp; PRINCIPLES</span>
                    <div class="arch-chips">
                        @foreach (var pattern in CurrentLayer.DesignPatterns)
                        {
                            <span class="arch-chip">@pattern</span>
                        }
                    </div>
                </div>
            </div>

            <div class="arch-block arch-packages">
                <span class="arch-block-label">ESSENTIAL PACKAGES &amp; TOOLS</span>
                <div class="arch-packages-row">
                    @foreach (var pkg in CurrentLayer.Packages)
                    {
                        <span class="arch-pkg-tag">
                            <i class="pkg-icon">📦</i>
                            <b>@pkg</b>
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="arch-side-col">
            <div class="arch-tree-card">
                <div class="tree-chrome">
                    <span></span><span></span><span></span>
                    <i>Solution Explorer: @CurrentLayer.ProjectName</i>
                </div>
                <div class="tree-content">
                    <div class="tree-root">📁 @CurrentLayer.ProjectName</div>
                    @foreach (var folder in CurrentLayer.FolderTree)
                    {
                        <div class="tree-item" style="padding-left: @(folder.Depth * 16)px">
                            <span class="tree-icon">@(folder.IsFolder ? "📁" : "📄")</span>
                            <span class="tree-name @(folder.IsHighlight ? "tree-highlight" : "")">@folder.Name</span>
                            @if (!string.IsNullOrEmpty(folder.Comment))
                            {
                                <span class="tree-comment">// @folder.Comment</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="sim-runner">
                <button type="button" class="button button-quiet sim-btn @(isSimulating ? "is-running" : "")" @onclick="SimulateRequestFlow" disabled="@isSimulating">
                    @if (isSimulating)
                    {
                        <span class="sim-pulse"></span>
                        <span>Tracing @simulationCurrentStepName...</span>
                    }
                    else
                    {
                        <span>⚡ Trace Request Lifecycle</span>
                    }
                </button>
                <div class="sim-status-text">
                    @if (isSimulating)
                    {
                        <span>Flow: <b>@simulationCurrentStepName</b></span>
                    }
                    else
                    {
                        <span>Click to animate request flow across the 4 layers</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string selectedLayerId = "domain";
    private bool isSimulating = false;
    private string? simulatingLayerId = null;
    private string simulationCurrentStepName = "";

    private LayerDefinition CurrentLayer => Layers.First(l => l.Id == selectedLayerId);

    private void SelectLayer(string id)
    {
        if (!isSimulating)
        {
            selectedLayerId = id;
        }
    }

    private async Task SimulateRequestFlow()
    {
        if (isSimulating) return;
        isSimulating = true;

        var flowOrder = new[]
        {
            ("api", "1/4 HTTP Request $\to$ Minimal API Endpoint"),
            ("application", "2/4 MediatR Send $\to$ Validation Pipeline"),
            ("domain", "3/4 Domain Entity Logic $\to$ Business Invariants"),
            ("infra", "4/4 EF Core UnitOfWork $\to$ SQL Server Commit")
        };

        foreach (var step in flowOrder)
        {
            selectedLayerId = step.Item1;
            simulatingLayerId = step.Item1;
            simulationCurrentStepName = step.Item2;
            StateHasChanged();
            await Task.Delay(1300);
        }

        simulatingLayerId = null;
        isSimulating = false;
        simulationCurrentStepName = "Flow Completed: HTTP 201 Created (14ms)";
        StateHasChanged();
    }

    public class TreeEntry
    {
        public int Depth { get; set; } = 1;
        public bool IsFolder { get; set; } = true;
        public string Name { get; set; } = "";
        public string? Comment { get; set; }
        public bool IsHighlight { get; set; }
    }

    public class LayerDefinition
    {
        public string Id { get; set; } = "";
        public string StepNumber { get; set; } = "";
        public string Name { get; set; } = "";
        public string Tier { get; set; } = "";
        public string AccentColor { get; set; } = "#c7f36b";
        public string GoldenRule { get; set; } = "";
        public string Description { get; set; } = "";
        public string ProjectName { get; set; } = "";
        public List<string> Responsibilities { get; set; } = new();
        public List<string> DesignPatterns { get; set; } = new();
        public List<string> Packages { get; set; } = new();
        public List<TreeEntry> FolderTree { get; set; } = new();
