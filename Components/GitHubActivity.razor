@inject HttpClient Http

<div class="github-activity-card">
    <div class="github-card-top">
        <div class="github-user-badge">
            <span class="github-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
            </span>
            <div>
                <strong>github.com/ibrahimelmasry</strong>
                <span>Open-Source Repositories &amp; Implementations</span>
            </div>
        </div>
        <a class="button button-quiet button-xs" href="https://github.com/ibrahimelmasry" target="_blank" rel="noreferrer">
            View on GitHub ↗
        </a>
    </div>

    <div class="github-repos-grid">
        @foreach (var repo in displayRepos)
        {
            <a class="github-repo-item" href="@repo.Url" target="_blank" rel="noreferrer">
                <div class="repo-top">
                    <span class="repo-name">@repo.Name</span>
                    <span class="repo-arrow">↗</span>
                </div>
                <p class="repo-desc">@repo.Description</p>
                <div class="repo-meta">
                    @if (!string.IsNullOrWhiteSpace(repo.Language))
                    {
                        <span class="repo-lang"><i class="lang-dot dot-@repo.Language.ToLowerInvariant()"></i>@repo.Language</span>
                    }
                    <span class="repo-badge">@repo.Tag</span>
                </div>
            </a>
        }
    </div>
</div>

@code {
    private record RepoItem(string Name, string Description, string Language, string Url, string Tag);

    private readonly List<RepoItem> displayRepos =
    [
        new("TechXpress", "Full-stack ASP.NET Core MVC electronics e-commerce platform with Entity Framework Core, SQL Server, and Stripe checkout.", "C#", "https://github.com/IbrahimElmasry/TechXpress", "E-Commerce"),
        new("rawafid", "Multilingual community knowledge platform with content management, dynamic categories, and event hub.", "PHP", "https://github.com/IbrahimElmasry/rawafid", "CMS"),
        new("AI-ELearning-Platform", "Graduation project: ASP.NET Core educational platform featuring online course exploration and conversational AI chatbot.", "C#", "https://github.com/ibrahimelmasry", "Graduation"),
        new("IbrahimElmasry.github.io", "Developer portfolio built with standalone Blazor WebAssembly on .NET 8, published statically on GitHub Pages.", "C#", "https://github.com/ibrahimelmasry/IbrahimElmasry.github.io", "Portfolio")
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Optionally enhance with live stats if GitHub API is reachable
            var user = await Http.GetFromJsonAsync<GitHubUser>("https://api.github.com/users/ibrahimelmasry");
            // If successfully fetched, data is verified live
        }
        catch
        {
            // Graceful fallback to verified repositories list without interrupting UI
        }
    }

    private class GitHubUser
    {
        public int public_repos { get; set; }
        public string? bio { get; set; }
    }
}
