@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ContentService Content
<div class="site-shell">
    <header class="topbar">
        <a href="@Nav.BaseUri" class="brand" @onclick="CloseMobileMenu">
            <span class="brand-mark">IT</span>
            <span>Ibrahim Tarek<span class="brand-dot">.</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
            <a href="@($"{Nav.BaseUri}#work")">Work</a>
            <a href="@($"{Nav.BaseUri}#services")">Services</a>
            <a href="@($"{Nav.BaseUri}#process")">Process</a>
            <a href="@($"{Nav.BaseUri}#about")">About</a>
            <a href="@($"{Nav.BaseUri}#experience")">Journey</a>
            <a href="@($"{Nav.BaseUri}#faq")">FAQs</a>
            <a href="@($"{Nav.BaseUri}#contact")">Contact</a>
        </nav>
        <div class="topbar-right-actions">
            <button type="button" class="topbar-cmd-btn" @onclick="() => commandPaletteRef?.Open()" title="Command Palette (Ctrl+K)">
                <span class="cmd-icon">⌘</span>
                <span class="cmd-label">Search</span>
                <kbd>⌘K</kbd>
            </button>
            <a class="nav-cta nav-cta-booking" href="book-a-call">Book a call <span>↗</span></a>
            <button type="button" 
                    class="mobile-menu-toggle @(isMobileMenuOpen ? "is-active" : "")" 
                    @onclick="ToggleMobileMenu" 
                    aria-label="Toggle navigation menu"
                    aria-expanded="@isMobileMenuOpen">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>
        </div>
    </header>

    <!-- Mobile Navigation Drawer -->
    <div class="mobile-nav-drawer @(isMobileMenuOpen ? "is-open" : "")" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
        <div class="mobile-nav-backdrop" @onclick="CloseMobileMenu"></div>
        <div class="mobile-nav-sheet">
            <div class="mobile-nav-header">
                <div class="mobile-nav-brand">
                    <span class="brand-mark">IT</span>
                    <span>Ibrahim Tarek<span class="brand-dot">.</span></span>
                </div>
                <button type="button" class="mobile-nav-close" @onclick="CloseMobileMenu" aria-label="Close menu">✕</button>
            </div>
            
            <nav class="mobile-nav-links">
                <a href="@($"{Nav.BaseUri}#work")" @onclick="CloseMobileMenu">
                    <span class="nav-num">01</span>
                    <span class="nav-text">Selected Work</span>
                    <span class="nav-arrow">↗</span>
                </a>
                <a href="@($"{Nav.BaseUri}#services")" @onclick="CloseMobileMenu">
                    <span class="nav-num">02</span>
                    <span class="nav-text">Services &amp; Capabilities</span>
                    <span class="nav-arrow">↗</span>
                </a>
                <a href="@($"{Nav.BaseUri}#process")" @onclick="CloseMobileMenu">
                    <span class="nav-num">03</span>
                    <span class="nav-text">Engineering Process</span>
                    <span class="nav-arrow">↗</span>
                </a>
                <a href="@($"{Nav.BaseUri}#about")" @onclick="CloseMobileMenu">
                    <span class="nav-num">04</span>
                    <span class="nav-text">About Ibrahim</span>
                    <span class="nav-arrow">↗</span>
                </a>
                <a href="@($"{Nav.BaseUri}#experience")" @onclick="CloseMobileMenu">
                    <span class="nav-num">05</span>
                    <span class="nav-text">Career Journey</span>
                    <span class="nav-arrow">↗</span>
                </a>
                <a href="@($"{Nav.BaseUri}#skills")" @onclick="CloseMobileMenu">
                    <span class="nav-num">06</span>
                    <span class="nav-text">Technical Toolkit</span>
                    <span class="nav-arrow">↗</span>
                </a>
                <a href="@($"{Nav.BaseUri}#faq")" @onclick="CloseMobileMenu">
                    <span class="nav-num">07</span>
                    <span class="nav-text">Frequently Asked Questions</span>
                    <span class="nav-arrow">↗</span>
                </a>
                <a href="@($"{Nav.BaseUri}#contact")" @onclick="CloseMobileMenu">
                    <span class="nav-num">08</span>
                    <span class="nav-text">Start a Conversation</span>
                    <span class="nav-arrow">↗</span>
                </a>
            </nav>

            <div class="mobile-nav-cta">
                <a class="button button-primary mobile-booking-btn" href="book-a-call" @onclick="CloseMobileMenu">
                    Schedule 1:1 Call <span>↗</span>
                </a>
                <div class="mobile-socials-row">
                    @if (!string.IsNullOrWhiteSpace(profile.GithubUrl)) { <a href="@profile.GithubUrl" target="_blank" rel="noreferrer">GitHub</a> }
                    @if (!string.IsNullOrWhiteSpace(profile.LinkedInUrl)) { <a href="@profile.LinkedInUrl" target="_blank" rel="noreferrer">LinkedIn</a> }
                    @if (!string.IsNullOrWhiteSpace(profile.Email)) { <a href="mailto:@profile.Email">Email</a> }
                </div>
            </div>
        </div>
    </div>
    <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>
    <main>@Body</main>
    <footer class="footer" id="footer">
        <div class="footer-grid">
            <!-- Col 1: Identity & Bio -->
            <div class="footer-col footer-identity">
                <a href="@Nav.BaseUri" class="footer-brand">
                    <span class="brand-mark">IT</span>
                    <span class="brand-text">Ibrahim Tarek<span class="brand-dot">.</span></span>
                </a>
                <p class="footer-bio">
                    ASP.NET Core &amp; Full-Stack C# Developer specialized in practical architecture, robust Web APIs, and clean relational database design.
                </p>
                <div class="footer-availability-chip">
                    <span class="pulse-beacon"></span>
                    <span>Available for software roles &amp; contracts</span>
                </div>
                <div class="footer-location-tag">
                    <span>Alexandria, Egypt (UTC+2) · Open to Remote &amp; Relocation</span>
                </div>
            </div>

            <!-- Col 2: Site Navigation -->
            <div class="footer-col">
                <span class="footer-col-title">NAVIGATION</span>
                <nav class="footer-nav-list" aria-label="Footer Navigation">
                    <a href="@($"{Nav.BaseUri}#work")"><span>01</span> Selected Work</a>
                    <a href="@($"{Nav.BaseUri}#services")"><span>02</span> Services &amp; Capabilities</a>
                    <a href="@($"{Nav.BaseUri}#process")"><span>03</span> Engineering Process</a>
                    <a href="@($"{Nav.BaseUri}#about")"><span>04</span> About Ibrahim</a>
                    <a href="@($"{Nav.BaseUri}#experience")"><span>05</span> Career &amp; Education</a>
                    <a href="@($"{Nav.BaseUri}#skills")"><span>06</span> Technology Stack</a>
                    <a href="@($"{Nav.BaseUri}#faq")"><span>07</span> Frequently Asked Questions</a>
                    <a href="@($"{Nav.BaseUri}#contact")"><span>08</span> Start a Conversation</a>
                </nav>
            </div>

            <!-- Col 3: Direct Connect & Scheduling -->
            <div class="footer-col">
                <span class="footer-col-title">CONNECT &amp; BOOK</span>
                <div class="footer-links-group">
                    @if (!string.IsNullOrWhiteSpace(profile.Email))
                    {
                        <a href="mailto:@profile.Email" class="footer-channel-link">
                            <span class="channel-icon">✉</span>
                            <span class="channel-label">Email</span>
                            <span class="channel-arrow">↗</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile.LinkedInUrl))
                    {
                        <a href="@profile.LinkedInUrl" target="_blank" rel="noreferrer" class="footer-channel-link">
                            <span class="channel-icon">in</span>
                            <span class="channel-label">LinkedIn</span>
                            <span class="channel-arrow">↗</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile.GithubUrl))
                    {
                        <a href="@profile.GithubUrl" target="_blank" rel="noreferrer" class="footer-channel-link">
                            <span class="channel-icon">⌘</span>
                            <span class="channel-label">GitHub</span>
                            <span class="channel-arrow">↗</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile.WhatsAppUrl))
                    {
                        <a href="@profile.WhatsAppUrl" target="_blank" rel="noreferrer" class="footer-channel-link">
                            <span class="channel-icon">💬</span>
                            <span class="channel-label">WhatsApp</span>
                            <span class="channel-arrow">↗</span>
                        </a>
                    }
                    <a href="book-a-call" class="footer-channel-link highlight-booking">
                        <span class="channel-icon">🗓</span>
                        <span class="channel-label">Schedule 1:1 Call</span>
                        <span class="channel-badge">Google Meet</span>
                        <span class="channel-arrow">↗</span>
                    </a>
                </div>
            </div>

            <!-- Col 4: System Architecture & Meta -->
            <div class="footer-col footer-system-spec">
                <span class="footer-col-title">SYSTEM ARCHITECTURE</span>
                <div class="spec-list">
                    <div class="spec-row">
                        <span class="spec-key">FRAMEWORK</span>
                        <strong class="spec-val">Blazor WebAssembly .NET 8</strong>
                    </div>
                    <div class="spec-row">
                        <span class="spec-key">HOSTING</span>
                        <strong class="spec-val">GitHub Pages (Static WASM)</strong>
                    </div>
                    <div class="spec-row">
                        <span class="spec-key">STYLE SYSTEM</span>
                        <strong class="spec-val">Dark Terminal / Custom CSS</strong>
                    </div>
                    <div class="spec-row">
                        <span class="spec-key">DEPLOYMENT</span>
                        <strong class="spec-val">GitHub Actions CI/CD Pipeline</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom-bar">
            <div class="footer-copy">
                <span>© @DateTime.Now.Year @(profile.Name.Length > 0 ? profile.Name : "Ibrahim Tarek"). Engineered with C# &amp; Blazor WebAssembly.</span>
            </div>
            <a class="footer-top-btn" href="@($"{Nav.BaseUri}#top")" aria-label="Back to top">
                <span>Back to top</span>
                <span class="top-arrow">↑</span>
            </a>
        </div>
    </footer>
    <CommandPalette @ref="commandPaletteRef" OnOpenResume="() => resumeModalRef?.Open()" OnOpenChat="OpenChatWidget" />
    <ResumeModal @ref="resumeModalRef" ResumeUrl="@profile.ResumeUrl" />
    <ChatWidget @ref="chatWidgetRef" />
</div>
<script src="js/motion.js?v=20260924-7"></script>
@code {
    private Profile profile = new();
    private CommandPalette? commandPaletteRef;
    private ResumeModal? resumeModalRef;
    private ChatWidget? chatWidgetRef;
    private bool isMobileMenuOpen;

    protected override async Task OnInitializedAsync() => profile = await Content.GetProfileAsync();

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private void OpenChatWidget()
    {
        chatWidgetRef?.Open();
    }
}


