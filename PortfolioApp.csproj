<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishDir>publish/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.31" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="build-temp/**/*.cs;**/obj/**/*.cs;**/bin/**/*.cs" />
    <Content Remove="build-temp/**;**/obj/**;**/bin/**" />
    <None Remove="build-temp/**;**/obj/**;**/bin/**" />
  </ItemGroup>

</Project>
